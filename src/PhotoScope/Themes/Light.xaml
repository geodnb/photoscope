<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Every brush here has a twin in the other theme file. -->
    <SolidColorBrush x:Key="Brush.Window" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Brush.Content" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Control" Color="#FDFDFD"/>
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#F6F6F6"/>
    <SolidColorBrush x:Key="Brush.ControlPressed" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#E3E3E3"/>
    <SolidColorBrush x:Key="Brush.ControlBorderStrong" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5D5D5D"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#005FB8"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#196EBF"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#3183CA"/>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Subtle" Color="#0F000000"/>
    <SolidColorBrush x:Key="Brush.SubtlePressed" Color="#08000000"/>
    <SolidColorBrush x:Key="Brush.SelectedFill" Color="#1F005FB8"/>
    <SolidColorBrush x:Key="Brush.Tile" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#9D5D00"/>
    <SolidColorBrush x:Key="Brush.WarningBg" Color="#FFF4CE"/>
    <SolidColorBrush x:Key="Brush.SuccessBg" Color="#DFF6DD"/>
    <SolidColorBrush x:Key="Brush.InfoBg" Color="#EAF2FB"/>
    <SolidColorBrush x:Key="Brush.ErrorBg" Color="#FDE7E9"/>
    <SolidColorBrush x:Key="Brush.Star" Color="#D49100"/>
    <SolidColorBrush x:Key="Brush.Flyout" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Shadow" Color="#26000000"/>
</ResourceDictionary>
