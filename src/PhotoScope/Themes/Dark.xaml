<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Every brush here has a twin in the other theme file. -->
    <SolidColorBrush x:Key="Brush.Window" Color="#202020"/>
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#202020"/>
    <SolidColorBrush x:Key="Brush.Content" Color="#272727"/>
    <SolidColorBrush x:Key="Brush.Card" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Brush.Control" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#323232"/>
    <SolidColorBrush x:Key="Brush.ControlPressed" Color="#272727"/>
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#3B3B3B"/>
    <SolidColorBrush x:Key="Brush.ControlBorderStrong" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#333333"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#60CDFF"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#5AB9E6"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#4FA6CC"/>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#000000"/>
    <SolidColorBrush x:Key="Brush.Subtle" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SubtlePressed" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="Brush.SelectedFill" Color="#2960CDFF"/>
    <SolidColorBrush x:Key="Brush.Tile" Color="#323232"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF99A4"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#FCE100"/>
    <SolidColorBrush x:Key="Brush.WarningBg" Color="#433519"/>
    <SolidColorBrush x:Key="Brush.SuccessBg" Color="#393D1B"/>
    <SolidColorBrush x:Key="Brush.InfoBg" Color="#1F2E3D"/>
    <SolidColorBrush x:Key="Brush.ErrorBg" Color="#442726"/>
    <SolidColorBrush x:Key="Brush.Star" Color="#FFC83D"/>
    <SolidColorBrush x:Key="Brush.Flyout" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Brush.Input" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Brush.Shadow" Color="#66000000"/>
</ResourceDictionary>
