<c:ThemedWindow x:Class="PhotoScope.Views.ImportDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:PhotoScope.Controls"
                Title="Import photos" Width="560" SizeToContent="Height" ResizeMode="NoResize"
                ShowInTaskbar="False" WindowStartupLocation="CenterOwner" AllowDrop="True">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,16,24,20" BorderThickness="0,1,0,0"
                Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Divider}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ImportButton" Content="Import" Style="{StaticResource AccentButton}" MinWidth="110" IsDefault="True" Click="OnImport"/>
                <Button Content="Cancel" MinWidth="110" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="24,20,24,20" Background="{DynamicResource Brush.Card}">
            <TextBlock Text="Import photos" Style="{StaticResource Text.Title}" Margin="0,0,0,4"/>
            <TextBlock Text="Add files or folders, or drop them onto this window." Style="{StaticResource Text.Caption}" Margin="0,0,0,14"/>

            <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Brush.ControlBorder}" Background="{DynamicResource Brush.Content}">
                <Grid MinHeight="96" MaxHeight="180">
                    <ListBox x:Name="SourceList" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="OnSourceKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
                                <Setter Property="MinHeight" Value="30"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Width="26" Height="26"
                                            ToolTip="Remove from the list" Click="OnRemoveSource" Tag="{Binding}"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyHint" Text="Nothing selected yet" Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Add files…" Click="OnAddFiles" MinWidth="110"/>
                <Button Content="Add folder…" Click="OnAddFolder" MinWidth="110" Margin="8,0,0,0"/>
            </StackPanel>
            <CheckBox x:Name="RecursiveBox" Content="Include subfolders" Margin="0,14,0,0"/>

            <TextBlock Text="How should PhotoScope store them?" Style="{StaticResource Text.Subtitle}" Margin="0,22,0,10"/>
            <RadioButton x:Name="ReferenceRadio" GroupName="Mode">
                <StackPanel>
                    <TextBlock Text="Reference in place"/>
                    <TextBlock Text="Photos stay where they are. Nothing is copied." Style="{StaticResource Text.Caption}"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="CopyRadio" GroupName="Mode" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Copy into library folder"/>
                    <TextBlock x:Name="CopyHint" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                </StackPanel>
            </RadioButton>

            <CheckBox x:Name="SkipDuplicatesBox" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Skip duplicates"/>
                    <TextBlock Text="Files whose content is already in the library (matched by content hash) won't be added again."
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                </StackPanel>
            </CheckBox>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
    </DockPanel>
</c:ThemedWindow>
