<c:ThemedWindow x:Class="PhotoScope.Views.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:c="clr-namespace:PhotoScope.Controls"
                xmlns:m="clr-namespace:PhotoScope.Models"
                xmlns:vm="clr-namespace:PhotoScope.ViewModels"
                xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
                mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
                Title="PhotoScope" Width="1400" Height="880" MinWidth="760" MinHeight="480"
                AllowDrop="True">
    <c:ThemedWindow.Resources>
        <!-- One gallery tile -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type m:Photo}">
            <Grid ToolTip="{Binding FileName}" ToolTipService.InitialShowDelay="900">
                <Border CornerRadius="4" Background="{DynamicResource Brush.Tile}"
                        Visibility="{Binding (c:Thumb.IsEmpty), ElementName=Img, Converter={StaticResource BoolToVis}}"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8"
                            Visibility="{Binding DecodeError, Converter={StaticResource NotNullToVis}}">
                    <TextBlock Text="&#xE91B;" Style="{StaticResource Text.Icon}" FontSize="26" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextTertiary}"/>
                    <TextBlock Text="Can't display" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                    <TextBlock Text="{Binding DecodeError}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="44" Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
                <Image x:Name="Img" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       c:Thumb.Photo="{Binding}" c:Thumb.Version="{Binding ThumbVersion}"
                       c:Thumb.DecodeSize="{Binding DataContext.ThumbDecodeSize, RelativeSource={RelativeSource AncestorType=ListBox}}">
                    <Image.LayoutTransform>
                        <RotateTransform Angle="{Binding Rotation}"/>
                    </Image.LayoutTransform>
                </Image>
                <Border Background="#A6000000" CornerRadius="4" Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="22" Foreground="#FFC83D" HorizontalAlignment="Center"/>
                        <TextBlock Text="Missing" Foreground="White" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Width="24" Height="24" CornerRadius="12" Background="#8C000000" Margin="6"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Visibility="{Binding IsFavourite, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE735;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="#FFC83D" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>
    </c:ThemedWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="232" MinWidth="160" MaxWidth="480"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ Sidebar ============================ -->
        <DockPanel Grid.Column="0" Background="{DynamicResource Brush.Sidebar}">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="18,16,12,16">
                    <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource Brush.Accent}">
                        <TextBlock Text="&#xE91B;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{DynamicResource Brush.OnAccent}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PhotoScope" FontFamily="{StaticResource Font.Display}" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,1"/>
                </StackPanel>
                <Button Style="{StaticResource AccentButton}" Command="{Binding ImportCommand}" Margin="12,0,12,6" Height="36"
                        ToolTip="Import files or folders (Ctrl+I). You can also drop them onto the window.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B5;" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Import"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="Library" Style="{StaticResource Text.Section}"/>
                <ListBox x:Name="SectionList" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavEntry}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0:N0}}" Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="15" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <Grid/>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" Style="{StaticResource Splitter}" DragCompleted="OnSplitterDragCompleted"/>

        <!-- ============================ Main area ============================ -->
        <Border Grid.Column="2" Background="{DynamicResource Brush.Content}" BorderBrush="{DynamicResource Brush.Divider}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <DockPanel>
                <!-- Toolbar -->
                <Grid DockPanel.Dock="Top" Margin="20,14,16,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ViewTitle}" Style="{StaticResource Text.Title}" VerticalAlignment="Bottom"/>
                        <TextBlock Text="{Binding ViewSubtitle}" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Width="280">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="32,5,30,5"
                                 c:Ui.Placeholder="Search names and tags" ToolTip="Search by file name or tag (Ctrl+F)"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="14" Margin="11,0,0,0" IsHitTestVisible="False"
                                   HorizontalAlignment="Left" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="26" Height="26" Margin="0,0,3,0"
                                HorizontalAlignment="Right" Command="{Binding ClearSearchCommand}" ToolTip="Clear search"
                                Visibility="{Binding SearchText, Converter={StaticResource NotNullToVis}}"/>
                    </Grid>

                    <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" LastChildFill="False">
                        <TextBlock Text="Sort by" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="150" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Field" SelectedValue="{Binding SortBy}"/>
                        <ToggleButton Margin="4,0,0,0" IsChecked="{Binding SortDescending}"
                                      c:Ui.CheckedBrush="Transparent" c:Ui.CheckedForeground="{DynamicResource Brush.Text}"
                                      ToolTip="Toggle ascending / descending">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
                                    <Setter Property="Content" Value="&#xE74A;"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Content" Value="&#xE74B;"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <StackPanel x:Name="RightTools" DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="&#xE80A;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <Slider Width="120" Minimum="80" Maximum="320" SmallChange="10" LargeChange="40" Margin="8,0" VerticalAlignment="Center"
                                    Value="{Binding ThumbnailSize}" ToolTip="Thumbnail size (Ctrl + mouse wheel)"/>
                            <TextBlock Text="&#xE80A;" Style="{StaticResource Text.Icon}" FontSize="18" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <!-- Banners -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Banners}" Margin="8,0,4,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:Banner}">
                            <Border x:Name="Bar" Style="{StaticResource InfoBar}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                                            Width="28" Height="28" Command="{Binding CloseCommand}" ToolTip="Dismiss" VerticalAlignment="Center"/>
                                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Actions}" VerticalAlignment="Center" Margin="8,0,4,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:BannerAction}">
                                                <Button Content="{Binding Label}" Margin="4,0,0,0" MinHeight="28" Padding="10,2"
                                                        Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="Glyph" Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="16"
                                               Margin="0,0,12,0" Foreground="{DynamicResource Brush.Accent}"/>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Success">
                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.SuccessBg}"/>
                                    <Setter TargetName="Glyph" Property="Foreground" Value="#0F7B0F"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.WarningBg}"/>
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Error">
                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.ErrorBg}"/>
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Import progress -->
                <Border DockPanel.Dock="Bottom" Padding="20,10,16,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Divider}"
                        Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelImportCommand}" Margin="16,0,0,0" MinWidth="90"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ImportStatus}" FontSize="13" Margin="0,0,0,6"/>
                            <ProgressBar Value="{Binding ImportPercent, Mode=OneWay}" Maximum="100"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Gallery -->
                <Grid>
                    <c:GalleryListBox x:Name="Gallery" ItemsSource="{Binding Photos}" SelectionMode="Extended" Padding="12,2,6,8"
                                      ItemContainerStyle="{StaticResource TileItem}" ItemTemplate="{StaticResource TileTemplate}"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.CacheLength="1,1"
                                      ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      SelectionChanged="OnGallerySelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel ItemSize="{Binding TileSize}" SpacingMode="Uniform" StretchItems="False"
                                                           MouseWheelDelta="96"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </c:GalleryListBox>

                    <!-- Empty library -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLibraryEmpty}" Value="True"/>
                                            <Condition Binding="{Binding IsLoading}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE91B;" Style="{StaticResource Text.Icon}" FontSize="48" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextTertiary}"/>
                        <TextBlock Text="Your library is empty" Style="{StaticResource Text.Subtitle}" FontSize="18" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                        <TextBlock Text="Import photos from your PC, or drag files and folders onto this window."
                                   Style="{StaticResource Text.Caption}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button Content="Import photos" Style="{StaticResource AccentButton}" Command="{Binding ImportCommand}"
                                HorizontalAlignment="Center" Margin="0,18,0,0" MinWidth="140"/>
                    </StackPanel>

                    <!-- Nothing matches -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                                Visibility="{Binding IsViewEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextTertiary}"/>
                        <TextBlock Text="Nothing to show here" Style="{StaticResource Text.Subtitle}" FontSize="16" HorizontalAlignment="Center" Margin="0,14,0,6"/>
                        <TextBlock Text="No photos match this view or search." Style="{StaticResource Text.Caption}" FontSize="14"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="Loading your library…" Style="{StaticResource Text.Caption}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</c:ThemedWindow>
