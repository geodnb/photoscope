<c:ThemedWindow x:Class="PhotoScope.Views.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:c="clr-namespace:PhotoScope.Controls"
                xmlns:m="clr-namespace:PhotoScope.Models"
                xmlns:vm="clr-namespace:PhotoScope.ViewModels"
                xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
                mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
                Title="PhotoScope" Width="1400" Height="880" MinWidth="760" MinHeight="480"
                AllowDrop="True">
    <c:ThemedWindow.Resources>
        <!-- One gallery tile -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type m:Photo}">
            <Grid ToolTip="{Binding FileName}" ToolTipService.InitialShowDelay="900">
                <Border CornerRadius="4" Background="{DynamicResource Brush.Tile}"
                        Visibility="{Binding (c:Thumb.IsEmpty), ElementName=Img, Converter={StaticResource BoolToVis}}"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8"
                            Visibility="{Binding DecodeError, Converter={StaticResource NotNullToVis}}">
                    <TextBlock Text="&#xE91B;" Style="{StaticResource Text.Icon}" FontSize="26" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextTertiary}"/>
                    <TextBlock Text="Can't display" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                    <TextBlock Text="{Binding DecodeError}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="44" Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
                <Image x:Name="Img" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       c:Thumb.Photo="{Binding}" c:Thumb.Version="{Binding ThumbVersion}"
                       c:Thumb.DecodeSize="{Binding DataContext.ThumbDecodeSize, RelativeSource={RelativeSource AncestorType=ListBox}}">
                    <Image.LayoutTransform>
                        <RotateTransform Angle="{Binding Rotation}"/>
                    </Image.LayoutTransform>
                </Image>
                <Border Background="#A6000000" CornerRadius="4" Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="22" Foreground="#FFC83D" HorizontalAlignment="Center"/>
                        <TextBlock Text="Missing" Foreground="White" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Width="24" Height="24" CornerRadius="12" Background="#8C000000" Margin="6"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Visibility="{Binding IsFavourite, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xEB52;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="#FF6B81" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>
    </c:ThemedWindow.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="232" MinWidth="160" MaxWidth="480"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ Sidebar ============================ -->
        <DockPanel Grid.Column="0" Background="{DynamicResource Brush.Sidebar}">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="18,16,12,16">
                    <Image Source="/PhotoScope;component/Assets/PhotoScope.png" Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="PhotoScope" FontFamily="{StaticResource Font.Display}" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,1"/>
                </StackPanel>
                <Button Style="{StaticResource AccentButton}" Command="{Binding ImportCommand}" Margin="12,0,12,6" Height="36"
                        ToolTip="Import files or folders (Ctrl+I). You can also drop them onto the window.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B5;" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Import"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="Library" Style="{StaticResource Text.Section}"/>
                <ListBox x:Name="SectionList" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavEntry}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0:N0}}" Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="15" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <DockPanel x:Name="SidebarBottom" DockPanel.Dock="Bottom" Margin="6,4,6,10">
                <Button Style="{StaticResource SubtleButton}" Command="{Binding OpenSettingsCommand}" HorizontalContentAlignment="Left"
                        Padding="12,6" ToolTip="Settings" AutomationProperties.Name="Settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Text.Icon}" FontSize="15" Margin="0,0,12,0"/>
                        <TextBlock Text="Settings"/>
                    </StackPanel>
                </Button>
            </DockPanel>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,10,10,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="13" Width="30" Height="28"
                            Command="{Binding CreatePlaylistCommand}" ToolTip="New playlist" AutomationProperties.Name="New playlist"/>
                    <TextBlock Text="Playlists" Style="{StaticResource Text.Section}" Margin="16,0,8,0" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid>
                    <ListBox x:Name="PlaylistList" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}"
                             ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AllowDrop="True" AutomationProperties.Name="Playlists">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Play" c:Ui.Icon="&#xE768;" Command="{Binding PlayPlaylistCommand}"/>
                                <MenuItem Header="Rename…" c:Ui.Icon="&#xE8AC;" Command="{Binding RenamePlaylistCommand}"/>
                                <MenuItem Header="Delete playlist…" c:Ui.Icon="&#xE74D;" Command="{Binding DeletePlaylistCommand}"/>
                                <Separator/>
                                <MenuItem Header="New playlist…" c:Ui.Icon="&#xE710;" Command="{Binding CreatePlaylistCommand}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Playlist}">
                                <DockPanel ToolTip="{Binding Name}">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0:N0}}" Style="{StaticResource Text.Caption}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE8FD;" Style="{StaticResource Text.Icon}" FontSize="15" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No playlists yet. Use + to create one, then drag photos into it." TextWrapping="Wrap"
                               Style="{StaticResource Text.Caption}" Margin="18,4,16,0" VerticalAlignment="Top"
                               Visibility="{Binding Playlists.Count, Converter={StaticResource ZeroToVis}}"/>
                </Grid>
            </DockPanel>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" Style="{StaticResource Splitter}" DragCompleted="OnSplitterDragCompleted"/>

        <!-- ============================ Main area ============================ -->
        <Border Grid.Column="2" Background="{DynamicResource Brush.Content}" BorderBrush="{DynamicResource Brush.Divider}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
          <Grid x:Name="ContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="PlaylistRow" Height="0"/>
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MinWidth="320"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition x:Name="PreviewColumn" Width="340" MinWidth="0" MaxWidth="900"/>
              </Grid.ColumnDefinitions>
            <DockPanel>
                <!-- Toolbar -->
                <Grid DockPanel.Dock="Top" Margin="20,14,16,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ViewTitle}" Style="{StaticResource Text.Title}" VerticalAlignment="Bottom"/>
                        <TextBlock Text="{Binding ViewSubtitle}" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Width="280">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="32,5,30,5"
                                 c:Ui.Placeholder="Search names and tags" ToolTip="Search by file name or tag (Ctrl+F)"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="14" Margin="11,0,0,0" IsHitTestVisible="False"
                                   HorizontalAlignment="Left" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="26" Height="26" Margin="0,0,3,0"
                                HorizontalAlignment="Right" Command="{Binding ClearSearchCommand}" ToolTip="Clear search"
                                Visibility="{Binding SearchText, Converter={StaticResource NotNullToVis}}"/>
                    </Grid>

                    <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" LastChildFill="False">
                        <TextBlock Text="Sort by" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="150" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Field" SelectedValue="{Binding SortBy}"/>
                        <ToggleButton Margin="4,0,0,0" IsChecked="{Binding SortDescending}"
                                      c:Ui.CheckedBrush="Transparent" c:Ui.CheckedForeground="{DynamicResource Brush.Text}"
                                      ToolTip="Toggle ascending / descending">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
                                    <Setter Property="Content" Value="&#xE74A;"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Content" Value="&#xE74B;"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <StackPanel x:Name="RightTools" DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="&#xE80A;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <Slider Width="120" Minimum="80" Maximum="320" SmallChange="10" LargeChange="40" Margin="8,0" VerticalAlignment="Center"
                                    Value="{Binding ThumbnailSize}" ToolTip="Thumbnail size (Ctrl + mouse wheel)"/>
                            <TextBlock Text="&#xE80A;" Style="{StaticResource Text.Icon}" FontSize="18" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <Border Width="1" Margin="12,6" Background="{DynamicResource Brush.Divider}"/>
                            <Button Command="{Binding SlideshowCommand}" ToolTip="Slideshow of this view (or of the selected photos)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="Slideshow"/>
                                </StackPanel>
                            </Button>
                            <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE8A1;" Margin="8,0,0,0" IsChecked="{Binding IsPreviewVisible}"
                                          ToolTip="Show or hide the details pane"/>
                            <ToggleButton x:Name="PlaylistToggle" Style="{StaticResource IconToggle}" Content="&#xE8FD;" IsChecked="{Binding IsPlaylistVisible}"
                                          ToolTip="Show or hide the playlist panel" AutomationProperties.Name="Toggle playlist panel"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <!-- Banners -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Banners}" Margin="8,0,4,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:Banner}">
                            <Border x:Name="Bar" Style="{StaticResource InfoBar}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                                            Width="28" Height="28" Command="{Binding CloseCommand}" ToolTip="Dismiss" VerticalAlignment="Center"/>
                                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Actions}" VerticalAlignment="Center" Margin="8,0,4,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:BannerAction}">
                                                <Button Content="{Binding Label}" Margin="4,0,0,0" MinHeight="28" Padding="10,2"
                                                        Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="Glyph" Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="16"
                                               Margin="0,0,12,0" Foreground="{DynamicResource Brush.Accent}"/>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Success">
                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.SuccessBg}"/>
                                    <Setter TargetName="Glyph" Property="Foreground" Value="#0F7B0F"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.WarningBg}"/>
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Error">
                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.ErrorBg}"/>
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Import progress -->
                <Border DockPanel.Dock="Bottom" Padding="20,10,16,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Divider}"
                        Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelImportCommand}" Margin="16,0,0,0" MinWidth="90"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ImportStatus}" FontSize="13" Margin="0,0,0,6"/>
                            <ProgressBar Value="{Binding ImportPercent, Mode=OneWay}" Maximum="100"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Gallery -->
                <Grid>
                    <c:GalleryListBox x:Name="Gallery" Style="{StaticResource {x:Type ListBox}}" ItemsSource="{Binding Photos}" SelectionMode="Extended" Padding="12,2,6,8"
                                      ItemContainerStyle="{StaticResource TileItem}" ItemTemplate="{StaticResource TileTemplate}"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.CacheLength="1,1"
                                      ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      SelectionChanged="OnGallerySelectionChanged" MouseDoubleClick="OnGalleryDoubleClick"
                                      KeyDown="OnGalleryKeyDown">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel ItemSize="{Binding TileSize}" SpacingMode="Uniform" StretchItems="False"
                                                           MouseWheelDelta="96"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </c:GalleryListBox>

                    <!-- Empty library -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLibraryEmpty}" Value="True"/>
                                            <Condition Binding="{Binding IsLoading}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE91B;" Style="{StaticResource Text.Icon}" FontSize="48" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextTertiary}"/>
                        <TextBlock Text="Your library is empty" Style="{StaticResource Text.Subtitle}" FontSize="18" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                        <TextBlock Text="Import photos from your PC, or drag files and folders onto this window."
                                   Style="{StaticResource Text.Caption}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button Content="Import photos" Style="{StaticResource AccentButton}" Command="{Binding ImportCommand}"
                                HorizontalAlignment="Center" Margin="0,18,0,0" MinWidth="140"/>
                    </StackPanel>

                    <!-- Nothing matches -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                                Visibility="{Binding IsViewEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextTertiary}"/>
                        <TextBlock Text="Nothing to show here" Style="{StaticResource Text.Subtitle}" FontSize="16" HorizontalAlignment="Center" Margin="0,14,0,6"/>
                        <TextBlock Text="No photos match this view or search." Style="{StaticResource Text.Caption}" FontSize="14"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="Loading your library…" Style="{StaticResource Text.Caption}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </DockPanel>

            <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Style="{StaticResource Splitter}" DragCompleted="OnSplitterDragCompleted"/>

            <!-- ============================ Preview pane ============================ -->
            <Border x:Name="PreviewPane" Grid.Column="2" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="1,0,0,0">
                <Grid Margin="16,16,16,14">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding SelectedPhoto, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="&#xE8B9;" Style="{StaticResource Text.Icon}" FontSize="36" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextTertiary}"/>
                        <TextBlock Text="Select a photo to see its details" Style="{StaticResource Text.Caption}" FontSize="13"
                                   Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Grid Visibility="{Binding SelectedPhoto, Converter={StaticResource NotNullToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="140"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="PreviewBox" CornerRadius="6" Background="{DynamicResource Brush.Tile}" Cursor="Hand"
                                ToolTip="Double-click to open the viewer" MouseLeftButtonDown="OnPreviewMouseDown">
                            <Grid>
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.LayoutTransform>
                                        <RotateTransform Angle="{Binding SelectedPhoto.Rotation}"/>
                                    </Image.LayoutTransform>
                                </Image>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                            Visibility="{Binding PreviewError, Converter={StaticResource NotNullToVis}}">
                                    <TextBlock Text="&#xE91B;" Style="{StaticResource Text.Icon}" FontSize="30" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextTertiary}"/>
                                    <TextBlock Text="Can&#x2019;t display this photo" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                                    <TextBlock Text="{Binding PreviewError}" Style="{StaticResource Text.Caption}" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                            <StackPanel x:Name="DetailsPanel">
                                <TextBlock Text="{Binding SelectedPhoto.FileName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                           Visibility="{Binding SelectionSummary, Converter={StaticResource NotNullToVis}}"/>

                                <StackPanel Orientation="Horizontal" Margin="-6,8,0,0">
                                    <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding SelectedPhoto.IsFavourite, Mode=OneWay}"
                                                  Command="{Binding ToggleFavouriteSelectedCommand}" ToolTip="Favourite (F)" AutomationProperties.Name="Favourite"
                                                  c:Ui.CheckedForeground="#E0475E">
                                        <ToggleButton.Content>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xEB51;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedPhoto.IsFavourite}" Value="True">
                                                                <Setter Property="Text" Value="&#xEB52;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </ToggleButton.Content>
                                    </ToggleButton>
                                    <Border Width="1" Margin="6,6" Background="{DynamicResource Brush.Divider}"/>
                                    <c:StarRating Value="{Binding SelectedPhoto.Rating}" Command="{Binding SetRatingSelectedCommand}"/>
                                </StackPanel>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE8EC;" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,8,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <TextBox x:Name="TagsBox" c:Ui.Placeholder="Add tags, separated by commas" FontSize="13"
                                             ToolTip="Tags are stored in PhotoScope's library, not in the file. Press Enter to save."
                                             AutomationProperties.Name="Tags"/>
                                </DockPanel>

                                <StackPanel x:Name="InfoRows" Margin="0,12,0,0">
                                    <StackPanel.Resources>
                                        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                            <Setter Property="Width" Value="92"/>
                                            <Setter Property="FontSize" Value="13"/>
                                        </Style>
                                        <Style TargetType="DockPanel">
                                            <Setter Property="Margin" Value="0,3"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <DockPanel>
                                        <TextBlock Text="Dimensions" Style="{StaticResource Label}"/>
                                        <TextBlock Text="{Binding SelectedPhoto.DimensionsText}" FontSize="13" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="File size" Style="{StaticResource Label}"/>
                                        <TextBlock Text="{Binding SelectedPhoto.SizeText}" FontSize="13"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Date taken" Style="{StaticResource Label}"/>
                                        <TextBlock Text="{Binding SelectedPhoto.DateTakenText}" FontSize="13" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <DockPanel Visibility="{Binding SelectedPhoto.CameraModel, Converter={StaticResource NotNullToVis}}">
                                        <TextBlock Text="Camera" Style="{StaticResource Label}"/>
                                        <TextBlock Text="{Binding SelectedPhoto.CameraModel}" FontSize="13" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Imported" Style="{StaticResource Label}"/>
                                        <TextBlock Text="{Binding SelectedPhoto.ImportedText}" FontSize="13" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Path" Style="{StaticResource Label}" VerticalAlignment="Top"/>
                                        <TextBox Text="{Binding SelectedPhoto.Path, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" FontSize="13"/>
                                    </DockPanel>
                                </StackPanel>

                                <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource Brush.WarningBg}"
                                        Visibility="{Binding SelectedPhoto.IsMissing, Converter={StaticResource BoolToVis}}">
                                    <TextBlock TextWrapping="Wrap" FontSize="13"
                                               Text="This file can&#x2019;t be found. Use Relocate to point PhotoScope at its new location, or remove it from the library."/>
                                </Border>

                                <WrapPanel x:Name="PreviewButtons" Margin="0,14,0,0">
                                    <Button Command="{Binding OpenViewerCommand}" Margin="0,0,8,8" ToolTip="Open in the full viewer (Enter)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE740;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Open"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ShowInExplorerCommand}" Margin="0,0,8,8" ToolTip="Show the file in File Explorer">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE838;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Show in Explorer"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding RelocateSelectedCommand}" Margin="0,0,8,8" Content="Relocate…"
                                            Visibility="{Binding SelectedPhoto.IsMissing, Converter={StaticResource BoolToVis}}"/>
                                    <Button Command="{Binding RemoveSelectedFromLibraryCommand}" Margin="0,0,8,8" Content="Remove from library…"
                                            Visibility="{Binding SelectedPhoto.IsMissing, Converter={StaticResource BoolToVis}}"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
            </Grid>

            <GridSplitter x:Name="PlaylistSplitter" Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          ResizeBehavior="PreviousAndNext" Style="{StaticResource Splitter}" DragCompleted="OnSplitterDragCompleted"
                          Visibility="Collapsed"/>

            <!-- ============================ Playlist panel ============================ -->
            <Border x:Name="PlaylistPane" Grid.Row="2" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,8,12,2">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Remove" Margin="0,0,8,0" ToolTip="Remove the selected photos from this playlist (Delete). The files aren't touched."
                                    Command="{Binding RemoveFromPlaylistCommand}" CommandParameter="{Binding SelectedItems, ElementName=PlaylistStrip}"
                                    Visibility="{Binding SelectedItems.Count, ElementName=PlaylistStrip, Converter={StaticResource NonZeroToVis}}"/>
                            <Button Style="{StaticResource AccentButton}" Command="{Binding PlayPlaylistCommand}" ToolTip="Play this playlist as a slideshow"
                                    IsEnabled="{Binding PlaylistItems.Count, Converter={StaticResource NonZeroToBool}}" AutomationProperties.Name="Play playlist">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="Play"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Margin="6,0,0,0"
                                    Command="{Binding TogglePlaylistPanelCommand}" ToolTip="Hide the playlist panel" AutomationProperties.Name="Hide playlist panel"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource Text.Icon}" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SelectedPlaylist.Name, FallbackValue=Playlist, TargetNullValue=Playlist}" Style="{StaticResource Text.Subtitle}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                            <TextBlock Text="{Binding PlaylistSummary}" Style="{StaticResource Text.Caption}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <ListBox x:Name="PlaylistStrip" Style="{StaticResource {x:Type ListBox}}" ItemsSource="{Binding PlaylistItems}"
                                 SelectionMode="Extended" AllowDrop="True" Padding="10,0,10,6" ItemContainerStyle="{StaticResource TileItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                 AutomationProperties.Name="Playlist contents">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:Photo}">
                                    <Grid Width="112" Height="112" ToolTip="{Binding FileName}">
                                        <Border CornerRadius="4" Background="{DynamicResource Brush.Tile}"
                                                Visibility="{Binding (c:Thumb.IsEmpty), ElementName=StripImg, Converter={StaticResource BoolToVis}}"/>
                                        <Image x:Name="StripImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                               c:Thumb.Photo="{Binding}" c:Thumb.Version="{Binding ThumbVersion}" c:Thumb.DecodeSize="240">
                                            <Image.LayoutTransform>
                                                <RotateTransform Angle="{Binding Rotation}"/>
                                            </Image.LayoutTransform>
                                        </Image>
                                        <Border Background="#A6000000" CornerRadius="4" Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" Foreground="#FFC83D" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Button Width="24" Height="24" MinHeight="0" Padding="0" Margin="4" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Content="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="10" Foreground="White"
                                                Background="#B3000000" BorderBrush="Transparent" c:Ui.HoverBrush="#E6000000" c:Ui.CornerRadius="12"
                                                ToolTip="Remove from playlist" AutomationProperties.Name="Remove from playlist"
                                                Command="{Binding DataContext.RemoveOneFromPlaylistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                                    Visibility="{Binding PlaylistItems.Count, Converter={StaticResource ZeroToVis}}">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource Text.Icon}" FontSize="26" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextTertiary}"/>
                            <TextBlock x:Name="PlaylistHint" Style="{StaticResource Text.Caption}" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center"
                                       Text="Drag photos here from the gallery, or right-click photos and choose Add to playlist."/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
          </Grid>
        </Border>
    </Grid>
</c:ThemedWindow>
